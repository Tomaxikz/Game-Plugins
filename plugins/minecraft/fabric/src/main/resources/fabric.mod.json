{
  "schemaVersion": 1,
  "id": "playermanager_bridge",
  "version": "${version}",
  "name": "Player Manager Bridge",
  "description": "Exposes live player data to the Calagopus Player Manager panel over a local socket. Server side only; vanilla clients can join.",
  "authors": ["Tomaxikz"],
  "license": "MIT",
  "environment": "server",
  "entrypoints": {
    "server": ["dev.playermanager.bridge.mod.fabric.FabricEntry"]
  },
  "mixins": ["playermanager_bridge.mixins.json", "playermanager_bridge_chunks.mixins.json"],
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": "${mcRange}",
    "java": ">=${javaMin}"
  }
}
