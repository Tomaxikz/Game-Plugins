    "assets.manifest",
    "assets.get",
    "map.chunks",
    "chunks.subscribe",
    "chunks.unsubscribe"
  ],
  "required_features": [
    "proxy"
  ],
  "forbidden_features": [
    "positions.stream",
    "inventory.write",
    "assets",
    "map.chunks",
    "chunks.stream"
  ],
  "required_player_fields": [],
  "required_containers": [],
  "checks": [
    "mc.proxy",
    "mc.uuid",
    "mc.version"
  ],
  "expect": {}
}
