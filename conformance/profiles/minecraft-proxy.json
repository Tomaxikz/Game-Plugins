{
  "name": "minecraft-proxy",
  "description": "Velocity and BungeeCord bridge. Network-level state only: no worlds, inventories, positions or assets.",
  "sources": [
    "docs/protocol/games/minecraft.md sections 9-10"
  ],
  "game": "minecraft_java",
  "platforms": [
    "velocity",
    "bungeecord"
  ],
  "required_ops": [
    "server.info",
    "players.list",
    "events.subscribe",
    "events.unsubscribe",
    "action.run"
  ],
